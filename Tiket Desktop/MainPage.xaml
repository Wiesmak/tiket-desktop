<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tiket_Desktop.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:Tiket.Desktop.Application"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Stacked" />
                <VisualState x:Name="Columns">
                    <VisualState.Setters>
                        <Setter Target="CashierPrimary.Width" Value="*" />
                        <Setter Target="CashierPrimary.MaxWidth" Value="680" />
                        <Setter Target="AdminPrimary.MaxWidth" Value="760" />
                        <Setter Target="CashierLayout.ColumnSpacing" Value="24" />
                        <Setter Target="AdminLayout.ColumnSpacing" Value="24" />
                        <Setter Target="CashierSecondary.Width" Value="*" />
                        <Setter Target="RecentPanel.(Grid.Column)" Value="1" />
                        <Setter Target="RecentPanel.(Grid.Row)" Value="0" />
                        <Setter Target="AdminPrimary.Width" Value="*" />
                        <Setter Target="AdminSecondary.Width" Value="*" />
                        <Setter Target="AdminSummary.(Grid.Column)" Value="1" />
                        <Setter Target="AdminSummary.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed" AlwaysShowHeader="False"
                        DisplayModeChanged="OnDisplayModeChanged"
                        SelectionChanged="OnNavigationChanged" PaneClosed="OnPaneClosed"
                        AutomationProperties.Name="Workspace navigation">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CashierItem" Content="Cashier" Tag="Cashier" Icon="Shop" AccessKey="C" />
                <NavigationViewItem Content="Administration" Tag="Administration" Icon="Edit" AccessKey="A" />
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <Grid x:Name="WorkspaceGutter" Padding="24,16,24,24">
                    <StackPanel x:Name="Workspace" Spacing="12" HorizontalAlignment="Stretch"
                                SizeChanged="OnWorkspaceSizeChanged">
                        <TextBlock x:Name="WorkspaceHeading" Text="Cashier" IsTabStop="True"
                                   Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" />

                            <ComboBox x:Name="KnownEvents" SelectionChanged="OnKnownEventChanged" Header="Event" HorizontalAlignment="Stretch" />
                        <StackPanel x:Name="CashierPanel" Spacing="8"><TextBlock x:Name="CashierLiveContext" Visibility="Collapsed" TextWrapping="Wrap" />
                            <TextBlock x:Name="CashierQuotationHeading" Text="Cashier quotation · disconnected" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="PurchaseFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Grid x:Name="CashierLayout" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CashierPrimary" Width="*" />
                                    <ColumnDefinition x:Name="CashierSecondary" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ComposerAvailability" Text="Sign in and read an authorized known event in Settings." TextWrapping="Wrap" />
                                    <ComboBox x:Name="QuoteRace" Header="Server race" HorizontalAlignment="Stretch" SelectionChanged="OnQuoteRace" />
                                    <ComboBox x:Name="QuotePool" Header="Bet type" HorizontalAlignment="Stretch" SelectionChanged="OnQuotePool" />
                                    <TextBlock x:Name="OrderGuidance" TextWrapping="Wrap" />
                                    <ComboBox x:Name="QuoteMode" Header="Selection mode" HorizontalAlignment="Stretch" SelectionChanged="OnQuoteMode" />
                                    <StackPanel x:Name="QuoteSlots" Spacing="8" />
                                    <TextBlock x:Name="BoxCount" TextWrapping="Wrap" Visibility="Collapsed" />
                                    <ListView x:Name="QuoteBox" SelectionMode="Multiple" MaxHeight="240" Visibility="Collapsed" SelectionChanged="OnQuoteBox" AutomationProperties.Name="Box horses" />
                                    <TextBox x:Name="QuoteUnits" Header="Units per combination" Text="1" MaxLength="64" AutomationProperties.AutomationId="QuoteUnits" TextChanged="OnQuoteUnits" InputScope="Number" />
                                    <TextBlock x:Name="QuoteFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressRing x:Name="QuoteProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="GetQuoteButton" Content="Get quote" Click="OnGetQuote" AccessKey="Q" IsEnabled="False" />
                                        <Button x:Name="CancelQuoteButton" Content="Cancel quote" Click="OnCancelQuote" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="QuoteSummary" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                                    <Expander x:Name="QuoteDetailsExpander" Header="Quote details" Visibility="Collapsed" HorizontalAlignment="Stretch"><TextBlock x:Name="QuoteDetails" TextWrapping="Wrap" /></Expander>
                                    <TextBox x:Name="PurchasePlayer" Header="Player UUID" MaxLength="36" TextChanged="OnCashierPlayerChanged" />
                                    <TextBlock x:Name="CashierAccountStatus" TextWrapping="Wrap" />
                                    <ComboBox x:Name="PurchasePos" Header="Point of sale" HorizontalAlignment="Stretch" SelectionChanged="OnPurchasePosChanged" />
                                    <TextBlock x:Name="PurchaseContext" TextWrapping="Wrap" />
                                    <Button x:Name="ReviewPurchaseButton" Content="Review purchase" Click="OnReviewPurchase" IsEnabled="False" />
                                </StackPanel>
                                <Border x:Name="RecentPanel" Grid.Row="1" Padding="16" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Recent transactions" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="LivePurchaseHistory" Spacing="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="AdminPanel" Visibility="Collapsed" Spacing="12"><TextBlock x:Name="AdminLiveContext" Visibility="Collapsed" TextWrapping="Wrap" />
                            <Grid x:Name="AdminLayout" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="AdminPrimary" Width="*" />
                                    <ColumnDefinition x:Name="AdminSecondary" Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel x:Name="LocalPlanEditor" Spacing="12">
                                    <TextBlock x:Name="LocalPlanStatus" Text="Local plan" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CreatedDefinitionSummary" TextWrapping="Wrap" />
                                        <TextBlock x:Name="PlanValidation" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SavePlanButton" Content="Save plan" Click="OnSavePlan" />
                                        <Button x:Name="ResumePlanButton" Content="Resume" Click="OnResumePlan" />
                                        <Button x:Name="DiscardPlanButton" Content="Discard" Click="OnDiscardPlan" />
                                    </StackPanel>
                                    <StackPanel x:Name="EditablePlanFields" Spacing="12">
                                    <ComboBox x:Name="BuilderStep" Header="Local plan step" SelectedIndex="0"
                                              SelectionChanged="OnBuilderStepChanged" AutomationProperties.Name="Local race-day builder step" HorizontalAlignment="Stretch">
                                        <x:String>1 · Basics</x:String><x:String>2 · Races</x:String><x:String>3 · Runners</x:String>
                                        <x:String>4 · Pool rules</x:String><x:String>5 · Review</x:String>
                                    </ComboBox>
                                    <TextBlock x:Name="StepDescription" TextWrapping="Wrap" />
                                    <StackPanel x:Name="BasicsStep" Spacing="12">
                                        <TextBox x:Name="PlanDay" Header="Provisioned event UUID" IsReadOnly="True" />
                                        <TextBox x:Name="PlanDate" Header="Event date (yyyy-MM-dd)" />
                                        <TextBox x:Name="PlanNumber" Header="Day display number (1–999)" InputScope="Number" Text="1" />
                                        <TextBox x:Name="PlanCurrency" Header="ISO currency" Text="PLN" MaxLength="3" />
                                        <TextBox x:Name="PlanZone" Header="IANA time zone" Text="Europe/Warsaw" />
                                        <TextBox x:Name="PlanRules" Header="Rules version" Text="1" />
                                        <TextBox x:Name="PlanLegs" Header="Maximum coupon legs" Text="10000" InputScope="Number" />
                                        <TextBox x:Name="PlanOpen" Header="Maximum concurrent open races" Text="1" InputScope="Number" />
                                        <TextBlock Text="No-winner policy: House retains pool" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="RacesStep" Spacing="12" Visibility="Collapsed">
                                        <ComboBox x:Name="PlanRace" Header="Ordered races" HorizontalAlignment="Stretch" SelectionChanged="OnPlanRaceChanged" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Add race" Click="OnAddPlanRace" />
                                            <Button Content="Remove" Click="OnRemovePlanRace" />
                                            <Button Content="Move up" Click="OnMovePlanRaceUp" />
                                            <Button Content="Move down" Click="OnMovePlanRaceDown" />
                                        </StackPanel>
                                        <TextBox x:Name="PlanRaceId" Header="Race UUID" IsReadOnly="True" />
                                        <TextBox x:Name="PlanRaceNumber" Header="Race number" TextChanged="OnPlanRaceFields" InputScope="Number" />
                                        <TextBox x:Name="PlanRaceTitle" Header="Title" TextChanged="OnPlanRaceFields" />
                                        <TextBox x:Name="PlanRaceCourse" Header="Course" TextChanged="OnPlanRaceFields" />
                                    </StackPanel>
                                    <StackPanel x:Name="RunnersStep" Spacing="12" Visibility="Collapsed">
                                        <TextBlock x:Name="RosterRaceLabel" TextWrapping="Wrap" />
                                        <Button Content="Add horse" Click="OnAddPlanHorse" />
                                        <StackPanel x:Name="PlanRunners" Spacing="12" />
                                    </StackPanel>
                                    <StackPanel x:Name="PoolsStep" Spacing="12" Visibility="Collapsed">
                                        <TextBlock x:Name="PoolsRaceLabel" TextWrapping="Wrap" />
                                        <StackPanel x:Name="PlanPools" Spacing="12" />
                                    </StackPanel>
                                    <StackPanel x:Name="ReviewStep" Spacing="12" Visibility="Collapsed">
                                        <Button x:Name="ReviewCreateButton" Content="Review and create day" Click="OnReviewCreateDay" />
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Border x:Name="AdminSummary" Grid.Row="1" Padding="16" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="AdminOperationStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock x:Name="AdminDayState" TextWrapping="Wrap" />
                                        <Button x:Name="PublishDayButton" Content="Publish day" Click="OnPublishDay" />
                                        <Button x:Name="StartDayButton" Content="Start day" Click="OnStartDay" />
                                        <Button x:Name="FinalizeDayButton" Content="Finalize day" Click="OnFinalizeDay" />
                                        <Button x:Name="CompleteDayButton" Content="Complete day" Click="OnCompleteDay" />
                                        <Button x:Name="CloseDayButton" Content="Close day" Click="OnCloseDay" />
                                        <TextBlock x:Name="ClosureSummary" TextWrapping="Wrap" />
                                        <ComboBox x:Name="ServerAdminRace" Header="Race" HorizontalAlignment="Stretch" SelectionChanged="OnAdminRaceChanged" />
                                        <TextBlock x:Name="AdminRaceState" TextWrapping="Wrap" />
                                        <Button x:Name="OpenRaceButton" Content="Open betting" Click="OnOpenRace" />
                                        <Button x:Name="CloseRaceButton" Content="Close betting" Click="OnCloseRace" />
                                        <StackPanel x:Name="RaceResultsPanel" Spacing="8">
                                            <TextBlock Text="Race operations &amp; results" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <ComboBox x:Name="ScratchRunner" Header="Horse to scratch" HorizontalAlignment="Stretch" />
                                            <Button x:Name="ScratchButton" Content="Scratch horse" Click="OnScratchHorse" />
                                            <Button x:Name="VoidButton" Content="Void race" Click="OnVoidRace" />
                                            <TextBox x:Name="ResultRevision" Header="Result revision" MaxLength="128" />
                                            <ComboBox x:Name="ResultKind" Header="Result kind" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                <x:String>Normal</x:String><x:String>Exceptional</x:String>
                                            </ComboBox>
                                            <TextBlock Text="Finishers in order" />
                                            <StackPanel x:Name="FinisherEditors" Spacing="8" />
                                            <Button x:Name="AddFinisherButton" Content="Add finisher" Click="OnAddFinisher" />
                                            <Button x:Name="SubmitResultButton" Content="Review result" Click="OnSubmitResult" />
                                            <TextBlock x:Name="LatestResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Button x:Name="VerifyResultButton" Content="Verify result" Click="OnVerifyResult" />
                                            <Button x:Name="SettleRaceButton" Content="Settle race — final" Click="OnSettleRace" />
                                            <TextBlock Text="Winners &amp; Payouts" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Name="WinnersStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock x:Name="WinnersText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <Expander Header="Server definition" HorizontalAlignment="Stretch">
                                            <TextBlock x:Name="ServerDefinition" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Expander>
                                        <TextBlock Text="Player enrollment and opening funding" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBox x:Name="AdminPlayer" Header="Player UUID" MaxLength="36" TextChanged="OnAdminPlayerChanged" />
                                        <Button Content="Player coupons and detail" Click="OnPlayerHistory" />
                                        <Button Content="Race status and revisions" Click="OnRaceHistory" />
                                        <Expander Header="Selected history" HorizontalAlignment="Stretch"><TextBlock x:Name="StaffHistory" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander>
                                        <TextBlock x:Name="AccountDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock x:Name="WithdrawalDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <Button x:Name="CashOutButton" Content="Review recorded cashout" Click="OnCashOut" />
                                        <Expander Header="Movement history" HorizontalAlignment="Stretch"><TextBlock x:Name="MovementDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></Expander>
                                        <TextBlock x:Name="AdminAccountStatus" TextWrapping="Wrap" />
                                        <TextBox x:Name="OpeningPaid" Header="Paid units" Text="0" InputScope="Number" MaxLength="19" />
                                        <TextBox x:Name="OpeningPromotional" Header="Promotional units" Text="0" InputScope="Number" MaxLength="19" />
                                        <Button x:Name="EnrollPlayerButton" Content="Enroll player" Click="OnEnrollPlayer" />
                                        <Button x:Name="AddFundingButton" Content="Add opening funding" Click="OnAddFunding" />
                                        <Button x:Name="ListPlayersButton" Content="Show enrolled players" Click="OnListPlayers" />
                                        <TextBlock x:Name="AdminPlayers" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="Recent commands" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <StackPanel x:Name="AdminCommands" Spacing="8" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
                            <ComboBox x:Name="Profiles" Header="Managed connection profile" HorizontalAlignment="Stretch" SelectionChanged="OnProfileChanged" />
                            <TextBlock x:Name="SessionStatus" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="PingButton" Content="Test API" Click="OnPing" />
                                <Button x:Name="SignInButton" Content="Sign in with browser" Click="OnSignIn" />
                                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelConnection" />
                            </StackPanel>
                            <Button x:Name="SignOutButton" Content="Sign out / switch operator" Click="OnSignOut" />

                            <Button x:Name="ReadButton" Content="Retry" Click="OnReadEvent" />
                            <Expander Header="Diagnostics" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="ProfileDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock x:Name="OperatorStatus" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PingDetails" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EventDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Expander>
                            <ComboBox Header="Appearance" SelectedIndex="0" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Appearance">
                                <x:String>System</x:String><x:String>Light</x:String><x:String>Dark</x:String>
                            </ComboBox>
                            <TextBlock Text="Appearance lasts for this session. Restart follows the system theme." TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>
